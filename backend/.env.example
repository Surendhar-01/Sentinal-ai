SENTINEL_SECRET_KEY=change-me-in-production
SENTINEL_DATABASE_URL=sqlite:///./data/sentinel.db
SENTINEL_CORS_ORIGINS=http://localhost:5173
SENTINEL_EMBEDDING_PROVIDER=hash
SENTINEL_EMBEDDING_MODEL=nomic-embed-text
SENTINEL_OLLAMA_URL=http://localhost:11434
SENTINEL_VECTOR_STORE=chroma
SENTINEL_CHROMA_PATH=./data/chroma
SENTINEL_LLM_PROVIDER=auto
SENTINEL_LLM_MODEL=llama3.2
# Groq is external: retrieved evidence leaves the on-premise boundary.
SENTINEL_ALLOW_EXTERNAL_AI=false
SENTINEL_GROQ_API_KEY=your_groq_api_key_here
SENTINEL_GROQ_BASE_URL=https://api.groq.com/openai/v1
SENTINEL_GROQ_MODEL=openai/gpt-oss-120b
